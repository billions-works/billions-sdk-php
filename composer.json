{
    "name": "billions-works/sdk-php",
    "description": "PHP SDK for the Billions public API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Billions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Billions\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "support": {
        "issues": "https://github.com/billions-works/billions-sdk-php/issues",
        "source": "https://github.com/billions-works/billions-sdk-php"
    }
}

